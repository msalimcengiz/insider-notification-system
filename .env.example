APP_NAME="Insider Notification System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
# One JSON object per line (correlation_id and notification_id included).
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=notifications
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Notification provider. Defaults to the bundled mock provider; to use
# webhook.site, create a URL there and configure it to answer 202 with
# {"messageId": "$request.uuid", "status": "accepted", "timestamp": "..."}.
NOTIFICATION_PROVIDER_URL=http://mock-provider:8080/
# Optional per-channel override:
# NOTIFICATION_PROVIDER_SMS_URL=
# NOTIFICATION_PROVIDER_EMAIL_URL=
# NOTIFICATION_PROVIDER_PUSH_URL=
NOTIFICATION_PROVIDER_TIMEOUT=5

NOTIFICATIONS_RATE_LIMIT_PER_SECOND=100
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_SMS_WORKERS=4
NOTIFICATIONS_EMAIL_WORKERS=4
NOTIFICATIONS_PUSH_WORKERS=4

# WebSocket status updates (Laravel Reverb, Pusher protocol).
# The app publishes to the `reverb` container; clients connect to
# ws://localhost:8080/app/${REVERB_APP_KEY}. Development credentials only.
REVERB_APP_ID=insider-notifications
REVERB_APP_KEY=local-notifications-key
REVERB_APP_SECRET=local-notifications-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=log
MAIL_FROM_ADDRESS="notifications@example.com"
MAIL_FROM_NAME="${APP_NAME}"
